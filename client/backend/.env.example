# Environment Configuration
# Copy this file to .env and configure for your environment

# Server Configuration
NODE_ENV=development
PORT=5001

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/sana-silver-client

# JWT Configuration
# IMPORTANT: Change these secrets in production to long random strings (min 32 characters)
JWT_ACCESS_SECRET=your-super-secret-access-key-change-this-min-32-characters
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-min-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Configuration
# See AUTH_COOKIE_CONFIGURATION.md for detailed guide
# Options: strict|lax|none (auto-detected: lax for dev, strict for prod)
COOKIE_SAME_SITE=lax
# Options: true|false|auto (auto = true if production, false if development)
COOKIE_SECURE=auto

# CORS Configuration
# Set to your frontend URL
CORS_ORIGIN=http://localhost:5174

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Upload Configuration
MAX_FILE_SIZE=5242880
MAX_FILES_PER_UPLOAD=10

# ===== ENVIRONMENT SPECIFIC EXAMPLES =====

# LOCAL DEVELOPMENT (localhost:5001 → localhost:5174)
# NODE_ENV=development
# COOKIE_SAME_SITE=lax
# COOKIE_SECURE=false
# CORS_ORIGIN=http://localhost:5174

# HOSTED DEV (Same Domain: dev.example.com)
# NODE_ENV=development
# COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true
# CORS_ORIGIN=https://dev.example.com

# HOSTED DEV (Different Domains: api-dev.example.com → app-dev.example.com)
# NODE_ENV=development
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true
# CORS_ORIGIN=https://app-dev.example.com

# PRODUCTION (Same Domain: example.com/api → example.com)
# NODE_ENV=production
# COOKIE_SAME_SITE=strict
# COOKIE_SECURE=true
# CORS_ORIGIN=https://example.com

# PRODUCTION (Different Domains: api.example.com → app.example.com)
# NODE_ENV=production
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true
# CORS_ORIGIN=https://app.example.com
